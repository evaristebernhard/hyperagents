{
  "name": "hyperagents-ui",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:backend && npm run test:fixtures && npm run test:backend-flow",
    "test:ui": "playwright test --ui",
    "format": "prettier --write src tests docs README.md *.json *.ts",
    "format:check": "prettier --check src tests docs README.md *.json *.ts",
    "dev:fixtures": "node scripts/dev.mjs --fixtures",
    "start": "node server/index.mjs",
    "test:backend": "node --test server/*.test.mjs",
    "test:backend-flow": "playwright test --config=playwright.backend.config.ts",
    "test:fixtures": "playwright test",
    "reset-password": "node scripts/reset-owner-password.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "~5.6.3",
    "vite": "^6.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
