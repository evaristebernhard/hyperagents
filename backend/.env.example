DATABASE_URL=postgres://hyper:change-me@127.0.0.1:55432/hyper_v1
DATA_DIR=./.data-v1
PUBLIC_ORIGIN=http://localhost:8081
# Optional explicit aliases, comma separated; no wildcard or arbitrary Origin reflection.
ADDITIONAL_ORIGINS=
HOST=127.0.0.1
PORT=8081
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
EXA_API_KEY=
RUNNER_URL=http://127.0.0.1:8082
RUNNER_TOKEN=replace-with-at-least-32-random-characters
RUNNER_PORT=8082
SANDBOX_IMAGE=hyperagents-sandbox:1

# Opt-in isolated persistent browser service; unavailable by default.
BROWSER_ENABLED=false
# BROWSER_URL=http://browser:8083
# BROWSER_TOKEN=<random secret, at least 32 characters>
# Private service-only volume; never put profiles in the web workspace.
# BROWSER_PROFILE_DIR=/profiles

# New task allocation only. Existing Rust tasks keep their runtime on rollback.
RUST_NEW_TASKS=false
# Set both sockets in the same private (0700) directory for standalone services.
# KERNEL_SOCKET=/path/to/private/run/kernel.sock
# KERNEL_BRIDGE_SOCKET=/path/to/private/run/bridge.sock
# Docker-free bundles built by python3 sandbox/build-runtime.py
SANDBOX_BACKEND=runsc
BROWSER_RUNTIME_KIND=lightweight
# COMPUTE_RUNTIME_DIR=/home/USER/.local/share/hyperagents/runtimes/compute
# BROWSER_RUNTIME_DIR=/home/USER/.local/share/hyperagents/runtimes/browser
SANDBOX_RUNSC=/usr/local/bin/runsc
