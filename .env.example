# Node 24+ required. Copy to .env; npm run dev/start loads it without overriding exported variables.
APP_HOST=127.0.0.1
APP_PORT=8787
APP_DATA_DIR=.data
APP_DEV_ORIGIN=http://127.0.0.1:5173
APP_MAX_FILE_BYTES=20971520
# Optional: initialize an EMPTY owner table only; >=12 characters. Never commit a real password.
# APP_OWNER_PASSWORD=
# Exact trusted browser origin for deliberate external use; no path/trailing slash.
# APP_PUBLIC_ORIGIN=https://your-host.example
# npm start can optionally serve a prebuilt dist directory. Default API only.
# APP_SERVE_DIST=1
# External APP_HOST binding is refused until an owner exists or bootstrap is supplied.
# TLS/reverse-proxy hardening and public exposure remain your responsibility.

# Optional real DeepSeek text generation (server-only). Set in private .env/deployment secrets.
# Never use VITE_DEEPSEEK_API_KEY, commit a real key, or bake it into Docker build args.
DEEPSEEK_API_KEY=

# Optional scholarly metadata search. Server-only; never use VITE_ for this secret.
OPENALEX_API_KEY=
# Identifying User-Agent for public APIs; may include your own public contact URL.
PUBLIC_API_USER_AGENT=Hyperagents-Replica/0.1

# Real account integrations: fill ONLY the services you use, in private .env.
# Restart Node, then Settings > Integrations > Test and enable.
GITHUB_TOKEN=
SLACK_BOT_TOKEN=
NOTION_TOKEN=
AIRTABLE_TOKEN=
TELEGRAM_BOT_TOKEN=
LINEAR_API_KEY=
STRIPE_SECRET_KEY=
ASANA_TOKEN=
# Google: choose a short-lived access token OR the refresh-token trio below.
# Leave GOOGLE_ACCESS_TOKEN empty if using automatic refresh credentials.
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
